# Backend environment — copy to .env and fill in.

# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=recon_control_tower
JWT_SECRET=change-me-to-32-plus-random-bytes

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001

# Cookie security: false for local http, true behind TLS
COOKIE_SECURE=false

# ---- LLM provider (required for the agentic copilot; pick ONE) ----
# Option A — any OpenAI-compatible gateway (custom base URL):
# CUSTOM_LLM_BASE_URL=https://your-gateway.example.com
# CUSTOM_LLM_API_KEY=your-key
# CUSTOM_LLM_MODEL=your-model-name

# Option B — Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Option C — OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Without any provider the API returns 503 on agent endpoints;
# deterministic reconciliation and all other features work regardless.

# Optional scheduler tuning
# SCHED_INTERVAL_S=30
# SCHED_CLAIM_LEASE_S=900

# Hardening: set to false in production to skip seeded demo accounts
# DEMO_SEEDS=false
