# Backend environment template — copy to .env (local) or set in your host's
# dashboard (Render/Railway/Fly). Never commit real secrets.

# MongoDB connection. Local: mongodb://localhost:27017
# Cloud: MongoDB Atlas SRV URI, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Database name created/seeded automatically on first boot.
DB_NAME=recon_control_tower

# 32+ random bytes. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string

# "true" behind HTTPS (Vercel/Render/Railway), "false" for plain-HTTP localhost.
COOKIE_SECURE=false

# Comma-separated allow-list of browser origins that may call the API.
# Local dev: http://localhost:3000,http://localhost:3001
# Production: your Vercel URL(s), e.g. https://recon-control-tower.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Agentic layer (optional; omit to run deterministic fallbacks only) ----
CUSTOM_LLM_BASE_URL=https://openrouter.ai/api
CUSTOM_LLM_MODEL=stealth/ox-alpha
CUSTOM_LLM_API_KEY=

# ---- Scheduler tuning (optional) ----
SCHED_INTERVAL_S=30
SCHED_CLAIM_LEASE_S=900
